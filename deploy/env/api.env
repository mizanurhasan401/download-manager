PORT=3000
HOST=127.0.0.1
NODE_ENV=production

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=download_manager
POSTGRES_PASSWORD=download_manager
POSTGRES_DB=download_manager
POSTGRES_SCHEMA=public

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

STORAGE_PATH=./storage

YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Export YouTube cookies as Netscape cookies.txt — see deploy/YOUTUBE-COOKIES.md
# YTDLP_COOKIES_FILE=/home/deploy/download-manager/api/cookies.txt
# YTDLP_PROXY=
YTDLP_RETRIES=3
YTDLP_TIMEOUT_MS=300000

MAX_DOWNLOAD_SIZE_MB=2048
MAX_CONCURRENT_DOWNLOADS=3

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

LOG_LEVEL=info
