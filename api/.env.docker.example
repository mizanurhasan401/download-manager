# Docker full-stack overrides (copy values into .env.development when using --profile full)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=download_manager
POSTGRES_PASSWORD=download_manager
POSTGRES_DB=download_manager
POSTGRES_SCHEMA=public

REDIS_HOST=redis
REDIS_PORT=6379

STORAGE_PATH=./storage

YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

MAX_DOWNLOAD_SIZE_MB=2048
MAX_CONCURRENT_DOWNLOADS=3

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

LOG_LEVEL=info
