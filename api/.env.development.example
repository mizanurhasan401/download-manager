PORT=3000
HOST=localhost
NODE_ENV=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=download_manager
POSTGRES_PASSWORD=download_manager
POSTGRES_DB=download_manager
POSTGRES_SCHEMA=public

# Optional override. If omitted, the app builds this from POSTGRES_* values above.
# DATABASE_URL=

REDIS_HOST=localhost
REDIS_PORT=6379

STORAGE_PATH=./storage

YTDLP_PATH=./bin/yt-dlp
FFMPEG_PATH=ffmpeg

# Optional: path to Netscape cookies.txt for YouTube bot checks
# YTDLP_COOKIES_FILE=./cookies.txt
# YTDLP_PROXY=
YTDLP_RETRIES=3
YTDLP_TIMEOUT_MS=300000

MAX_DOWNLOAD_SIZE_MB=2048
MAX_CONCURRENT_DOWNLOADS=3

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

LOG_LEVEL=info
